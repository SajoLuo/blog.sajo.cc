---
import { siteConfig } from '../config';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navPages = [
  { title: 'HOME', href: '/' },
  { title: 'ABOUT', href: '/about/' },
  { title: 'TAGS', href: '/tags/' },
];
---

<nav
  id="main-nav"
  class:list={[
    'navbar-slide fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    transparent ? 'bg-transparent' : 'bg-white shadow-sm',
  ]}
>
  <div class="mx-auto px-6 md:px-10 flex items-center justify-between h-14">
    <!-- Brand (left-aligned) -->
    <a href="/" class:list={[
      'font-extrabold tracking-wider no-underline uppercase',
      'text-[18px]',
      transparent ? 'text-white' : 'text-gray-dark',
    ]}>
      {siteConfig.title}
    </a>

    <!-- Desktop links (right-aligned) -->
    <div class="hidden md:flex items-center gap-8">
      {navPages.map((page) => (
        <a
          href={page.href}
          class:list={[
            'font-bold no-underline hover:opacity-80 transition-opacity uppercase',
            'text-[13px] tracking-[1px]',
            transparent ? 'text-white' : 'text-gray-dark',
          ]}
        >
          {page.title}
        </a>
      ))}
    </div>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      class="md:hidden p-2"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <i class:list={['fa fa-bars text-lg', transparent ? 'text-white' : 'text-gray-dark']}></i>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="nav-mobile" class="hidden md:hidden bg-white border-t border-gray-light">
    <div class="mx-auto px-6 md:px-10 py-3 flex flex-col gap-3">
      {navPages.map((page) => (
        <a
          href={page.href}
          class="text-xs font-semibold tracking-widest text-gray-dark no-underline hover:text-brand uppercase"
        >
          {page.title}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    mobile?.classList.toggle('hidden');
    const expanded = !mobile?.classList.contains('hidden');
    toggle?.setAttribute('aria-expanded', String(expanded));
  });

  let lastScroll = 0;
  const headerHeight = window.innerHeight * 0.4;

  window.addEventListener('scroll', () => {
    if (!nav) return;
    const current = window.scrollY;

    if (current > 50) {
      nav.classList.remove('bg-transparent');
      nav.classList.add('bg-white', 'shadow-sm');
      nav.querySelectorAll('a, i').forEach(el => {
        el.classList.remove('text-white');
        el.classList.add('text-gray-dark');
      });
    } else if (nav.dataset.transparent === 'true') {
      nav.classList.add('bg-transparent');
      nav.classList.remove('bg-white', 'shadow-sm');
      nav.querySelectorAll('a, i').forEach(el => {
        el.classList.add('text-white');
        el.classList.remove('text-gray-dark');
      });
    }

    if (window.innerWidth > 1170) {
      if (current > lastScroll && current > headerHeight) {
        nav.classList.add('is-hidden');
      } else {
        nav.classList.remove('is-hidden');
      }
    }

    lastScroll = current;
  });

  if (nav?.classList.contains('bg-transparent')) {
    nav.dataset.transparent = 'true';
  }
</script>
