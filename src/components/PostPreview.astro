---
interface Props {
  title: string;
  subtitle?: string;
  date: Date;
  slug: string;
  tags?: string[];
  excerpt?: string;
}

const { title, subtitle, date, slug, tags, excerpt } = Astro.props;
---

<article class="py-6 border-b border-brand/30 last:border-b-0">
  <a href={`/posts/${slug}/`} class="no-underline group block">
    <h2 class="text-2xl md:text-[28px] font-bold font-serif text-gray-dark group-hover:text-brand transition-colors mb-1 leading-snug">
      {title}
    </h2>
    {subtitle && (
      <h3 class="text-sm text-gray group-hover:text-brand font-normal mb-2 transition-colors">{subtitle}</h3>
    )}

    {excerpt && (
      <p class="text-sm text-gray-l group-hover:text-gray leading-relaxed mt-2 transition-colors">{excerpt}</p>
    )}
  </a>

  <p class="text-sm text-gray-l mt-3 italic font-serif">
    Posted by Sajo on{' '}
    {date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })}
  </p>
</article>
