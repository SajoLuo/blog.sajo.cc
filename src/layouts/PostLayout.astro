---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Giscus from '../components/Giscus.astro';
import { siteConfig } from '../config';
import { getTagCounts } from '../utils';

const allPosts = await getCollection('posts');
const tagCounts = getTagCounts(allPosts);
const featuredTags = Object.entries(tagCounts)
  .filter(([, count]) => count > siteConfig.featuredTagMinCount)
  .sort((a, b) => b[1] - a[1]);

interface Props {
  title: string;
  subtitle?: string;
  headerImg?: string;
  headerMask?: number;
  tags?: string[];
  author?: string;
  date: Date;
  catalog?: boolean;
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
}

const { title, subtitle, headerImg, headerMask, tags, author, date, catalog, prevPost, nextPost } = Astro.props;
---

<BaseLayout title={title}>
  <Header
    title={title}
    subtitle={subtitle}
    headerImg={headerImg}
    headerMask={headerMask}
    tags={tags}
    author={author}
    date={date}
    variant="post"
  />

  <div class="max-w-[1170px] mx-auto px-4 py-10">
    {/* 12-column grid: offset-2 + content-8 + catalog-2 */}
    <div class="lg:grid lg:grid-cols-12 items-start">
      {/* Offset: 2 cols */}
      <div class="hidden lg:block lg:col-span-2"></div>

      {/* Main content: 8 cols */}
      <main class="lg:col-span-8">
        <article class="post-container prose max-w-none">
          <slot />
        </article>

        {/* Post navigation — half-width cards like original */}
        {(prevPost || nextPost) && (
          <ul class="list-none p-0 mt-10 flex flex-col sm:flex-row gap-4">
            {prevPost ? (
              <li class="flex-1">
                <a
                  href={`/posts/${prevPost.slug}/`}
                  class="pager-link block border border-[#ddd] bg-white no-underline text-center transition-all duration-200"
                  style="padding: 20px 15px; color: #404040;"
                >
                  <span class="text-sm font-bold uppercase tracking-widest">Previous</span><br />
                  <span class="text-gray text-sm">{prevPost.title}</span>
                </a>
              </li>
            ) : <li class="flex-1" />}
            {nextPost ? (
              <li class="flex-1">
                <a
                  href={`/posts/${nextPost.slug}/`}
                  class="pager-link block border border-[#ddd] bg-white no-underline text-center transition-all duration-200"
                  style="padding: 20px 15px; color: #404040;"
                >
                  <span class="text-sm font-bold uppercase tracking-widest">Next</span><br />
                  <span class="text-gray text-sm">{nextPost.title}</span>
                </a>
              </li>
            ) : <li class="flex-1" />}
          </ul>
        )}

        {/* Featured Tags + Friends below pager, like original */}
        <section class="mt-12">
          {featuredTags.length > 0 && (
            <div class="mb-8">
              <hr class="border-gray-light mb-4" />
              <h5 class="text-xs font-extrabold uppercase tracking-widest text-gray-dark mb-4">Featured Tags</h5>
              <div class="flex flex-wrap gap-2">
                {featuredTags.map(([tag]) => (
                  <a
                    href={`/tags/#${tag}`}
                    class="text-xs text-gray-l border border-gray-l/60 rounded-full px-3 py-1 no-underline hover:text-brand hover:border-brand transition-colors"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )}
          {siteConfig.friends.length > 0 && (
            <div class="mb-8">
              <hr class="border-gray-light mb-4" />
              <h5 class="text-xs font-extrabold uppercase tracking-widest text-gray-dark mb-3">Friends</h5>
              <ul class="flex flex-wrap gap-x-3 gap-y-1 list-none p-0">
                {siteConfig.friends.map((friend) => (
                  <li>
                    <a href={friend.href} target="_blank" rel="noopener" class="text-sm text-gray hover:text-brand no-underline">
                      {friend.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>

        <Giscus />
      </main>

      {/* Catalog: 2 cols */}
      {catalog && (
        <div class="hidden xl:block xl:col-span-2" id="catalog-column">
          <div id="side-catalog" class="sticky top-16 max-h-[70vh] overflow-y-auto text-sm pl-6">
            <h5 class="text-xs font-bold uppercase tracking-widest text-gray mb-3 cursor-pointer" id="catalog-toggle">
              CATALOG <span class="text-gray-l">&minus;</span>
            </h5>
            <ul id="catalog-list" class="list-none p-0 space-y-1"></ul>
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

{catalog && (
  <script>
    function initCatalog() {
      const container = document.querySelector('.post-container');
      const list = document.getElementById('catalog-list');
      const catalog = document.getElementById('side-catalog');
      const toggle = document.getElementById('catalog-toggle');

      if (!container || !list || !catalog) return;

      const headings = container.querySelectorAll('h1, h2, h3, h4, h5, h6');
      if (headings.length === 0) {
        catalog.style.display = 'none';
        return;
      }

      headings.forEach((heading, i) => {
        const id = heading.id || `heading-${i}`;
        heading.id = id;

        const level = parseInt(heading.tagName[1]);
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${id}`;
        a.textContent = heading.textContent?.replace(/^#\s*/, '') || '';
        a.className = 'block text-gray hover:text-brand no-underline py-0.5 truncate transition-colors';

        if (level >= 3) {
          a.classList.add('pl-3', 'text-xs');
        } else {
          a.classList.add('font-medium');
        }

        li.appendChild(a);
        list.appendChild(li);
      });

      const links = list.querySelectorAll('a');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              links.forEach((link) => {
                (link as HTMLElement).style.color = '';
              });
              const activeLink = list.querySelector(`a[href="#${entry.target.id}"]`);
              if (activeLink) {
                (activeLink as HTMLElement).style.color = '#0085A1';
              }
            }
          });
        },
        { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
      );

      headings.forEach((heading) => observer.observe(heading));

      let collapsed = false;
      toggle?.addEventListener('click', () => {
        collapsed = !collapsed;
        (list as HTMLElement).style.display = collapsed ? 'none' : '';
        const span = toggle.querySelector('span');
        if (span) span.textContent = collapsed ? '+' : '−';
      });
    }

    initCatalog();
  </script>
)}
