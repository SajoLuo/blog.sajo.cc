---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" transparentNav={false}>
  <div class="flex flex-col items-center justify-center min-h-[80vh] text-center px-4">
    <h1 class="text-8xl font-bold text-gray-light mb-4">404</h1>
    <p class="text-xl text-gray mb-8">Page not found</p>
    <a
      href="/"
      class="text-brand hover:text-brand-dark no-underline text-lg transition-colors"
    >
      &larr; Back to Home
    </a>
  </div>
</BaseLayout>
