---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import Pager from '../components/Pager.astro';
import { siteConfig } from '../config';
import { getExcerpt } from '../utils';

const allPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageSize = siteConfig.pagination.pageSize;
const posts = allPosts.slice(0, pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);
---

<PageLayout title={siteConfig.title} subtitle={siteConfig.description}>
  {posts.map((post) => (
    <PostPreview
      title={post.data.title}
      subtitle={post.data.subtitle}
      date={post.data.date}
      slug={post.id}
      tags={post.data.tags}
      excerpt={getExcerpt(post.body)}
    />
  ))}

  <Pager
    prevUrl={totalPages > 1 ? '/page/2/' : undefined}
  />
</PageLayout>
