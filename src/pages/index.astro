---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import Pager from '../components/Pager.astro';
import { siteConfig } from '../config';

const allPosts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pageSize = siteConfig.pagination.pageSize;
const posts = allPosts.slice(0, pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);

function getExcerpt(body: string | undefined): string {
  if (!body) return '';
  return body
    .replace(/^#{1,6}\s+.*$/gm, '')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[([^\]]*)\]\(.*?\)/g, '$1')
    .replace(/[*_~`>]/g, '')
    .replace(/\n+/g, ' ')
    .trim()
    .slice(0, 170) + '…';
}
---

<PageLayout title={siteConfig.title} subtitle={siteConfig.description}>
  {posts.map((post) => (
    <PostPreview
      title={post.data.title}
      subtitle={post.data.subtitle}
      date={post.data.date}
      slug={post.id}
      tags={post.data.tags}
      excerpt={getExcerpt(post.body)}
    />
  ))}

  <Pager
    prevUrl={totalPages > 1 ? '/page/2/' : undefined}
  />
</PageLayout>
